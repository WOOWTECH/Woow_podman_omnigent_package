# omnigent-runner: always-on runner that dials into omnigent-server over the private
# network and offers the pi harness to every session started from the web UI.
#
# Rendered by scripts/install.sh from ~/.config/omnigent/omnigent.env.
#
# - admin password from the podman secret omnigent-admin-password (the username is a
#   per-host setting); the runner logs in with them on every start
# - pi state: @@OMNIGENT_PI_VOLUME@@, chosen by OMNIGENT_PI_STATE (private =
#   omnigent-pi.volume, shared = pi-agent-data.volume owned by Woow_podman_pi_agent_package).
#   The runner gets a real systemd dependency on that volume unit either way.
# - pinned local image tag: <omnigent version>-<package revision> (the VERSION file)
[Unit]
Description=omnigent-runner: always-on pi harness runner for Omnigent
Documentation=https://github.com/WOOWTECH/Woow_podman_omnigent_package
Requires=omnigent-server.service
After=omnigent-server.service

[Container]
ContainerName=omnigent-runner
# Built by scripts/install.sh from ./Containerfile.runner.
Image=localhost/woow-omnigent-runner:0.12.0-1
Pull=never
Network=omnigent.network

# Map the installing host user to container uid 1000, so pi's files on the volume stay
# owned by that user (and match pi-web's in shared mode).
UserNS=keep-id:uid=1000,gid=1000
Volume=@@OMNIGENT_PI_VOLUME@@:/data/pi-agent

Environment=OMNIGENT_SERVER_URL=http://omnigent-server:8000
Environment=OMNIGENT_ADMIN_USERNAME=@@OMNIGENT_ADMIN_USERNAME@@
Secret=omnigent-admin-password,type=env,target=OMNIGENT_ADMIN_PASSWORD

# Every pi subprocess the runner launches goes through the HOME-rescoping wrapper.
Environment=OMNIGENT_PI_PATH=/usr/local/bin/pi-code
Environment=PI_CODING_AGENT_DIR=/data/pi-agent
Environment=PI_TELEMETRY=0
Environment=PI_SKIP_VERSION_CHECK=1

NoNewPrivileges=true

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
