# omnigent-server: the Omnigent orchestration server and web UI (upstream image).
#
# Rendered by scripts/install.sh from ~/.config/omnigent/omnigent.env (the double-at tokens
# are listed in quadlet/render-vars). Edit the env file and re-run install.sh; do not edit
# the installed copy.
#
# - pinned to v0.12.0: the digest woowtechopenclaw runs, and the omnigent CLI version in
#   the runner image (bump both together, with a database dump first)
# - DATABASE_URL comes from a podman secret derived from the generated DB password
# - published on 127.0.0.1 by default; the outward door is a tailnet or tunnel front end
[Unit]
Description=omnigent-server: Omnigent orchestration server + web UI
Documentation=https://github.com/WOOWTECH/Woow_podman_omnigent_package
Requires=omnigent-postgres.service
After=omnigent-postgres.service

[Container]
ContainerName=omnigent-server
Image=ghcr.io/omnigent-ai/omnigent-server:v0.12.0
Network=omnigent.network
PublishPort=@@OMNIGENT_BIND@@:@@OMNIGENT_PORT@@:8000
Volume=omnigent-server.volume:/data

# Upstream reads DATABASE_URL from the environment first (deploy/docker/entrypoint.py).
Secret=omnigent-database-url,type=env,target=DATABASE_URL

Environment=HOST=0.0.0.0
Environment=PORT=8000
Environment=ARTIFACT_DIR=/data/artifacts
Environment=OMNIGENT_ADMIN_CREDENTIALS_PATH=/data/admin-credentials
Environment=OMNIGENT_AUTH_ENABLED=1
Environment=OMNIGENT_FEATURES=usage_page,harness_install
# Public or tailnet URL used in invite links and OAuth redirects. Empty lets upstream
# derive it from HOST/PORT, which is fine for loopback-only use.
Environment=OMNIGENT_ACCOUNTS_BASE_URL=@@OMNIGENT_ACCOUNTS_BASE_URL@@

# /health is JSON; /healthz is swallowed by the SPA catch-all (always 200).
HealthCmd=curl -sf http://127.0.0.1:8000/health
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3

NoNewPrivileges=true

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
