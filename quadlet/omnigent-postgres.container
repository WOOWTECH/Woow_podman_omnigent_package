# omnigent-postgres: PostgreSQL 16 for the Omnigent server. Not published to any host port;
# only omnigent-server reaches it, over the private omnigent network.
#
# - The role password is a podman secret generated by scripts/install.sh and mounted as a
#   file (POSTGRES_PASSWORD_FILE), so it is not in the unit, `podman inspect` or the journal.
# - Readiness gate in ExecStartPost=, because podman 4.9.3 ignores Notify=healthy: the unit
#   only turns active once Postgres accepts TCP connections, so omnigent-server's
#   Requires=/After= really waits for a usable database.
[Unit]
Description=omnigent-postgres: PostgreSQL 16 for Omnigent
Documentation=https://github.com/WOOWTECH/Woow_podman_omnigent_package

[Container]
ContainerName=omnigent-postgres
Image=docker.io/library/postgres:16.15-alpine3.24
Network=omnigent.network
Volume=omnigent-postgres.volume:/var/lib/postgresql/data

Environment=POSTGRES_DB=omnigent
Environment=POSTGRES_USER=omnigent
# Read by initdb on an EMPTY volume only. An adopted volume keeps the role's existing
# password; change it with scripts/rotate-secrets.sh --db (ALTER ROLE + both secrets).
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Secret=omnigent-postgres-password,type=mount,target=/run/secrets/postgres-password,mode=0400

# -h 127.0.0.1: during first-boot init the entrypoint runs a temporary server on the unix
# socket only; a socket probe would report "ready" too early.
HealthCmd=pg_isready -h 127.0.0.1 -p 5432 -U omnigent -d omnigent
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s

NoNewPrivileges=true

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300
ExecStartPost=/usr/bin/timeout 240 /bin/sh -c 'until podman exec omnigent-postgres pg_isready -h 127.0.0.1 -p 5432 -U omnigent -d omnigent >/dev/null 2>&1; do sleep 2; done'

[Install]
WantedBy=default.target
