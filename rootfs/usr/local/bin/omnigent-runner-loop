#!/bin/sh
# omnigent-runner-loop — long-lived entrypoint for the runner container.
#
# Boot sequence:
#   1. Wait for omnigent-server /health.
#   2. Log in with omnigent-runner-login: POST /auth/login for a login-scoped refresh grant,
#      then the CLI's own store_token(), so the host daemon renews its access token by itself.
#      The login is retried while the account may not exist yet (a fresh install creates it
#      a few seconds after the server answers /health).
#   3. Kick off `omnigent host --background --non-interactive` — the host daemon dials in,
#      registers this container as a host with the server, and stays up in its own process.
#   4. Stay in the foreground, so podman/systemd sees a live process, and watch over the
#      runner: tail the host daemon's log (it surfaces in `podman logs -f omnigent-runner`),
#      renew the login when it can no longer be renewed from its refresh grant (the grant has
#      an absolute lifetime, OMNIGENT_GRANT_MAX_LIFETIME_DAYS on the server, 30 days by
#      default), and start the host daemon again if it is gone.
#
# On a container restart this whole thing runs again — $HOME is baked into the image, not a
# volume, so the stored login is gone, we log in again and register with a fresh host id.
# The old host id in the server DB is left behind (offline), which is the same shape you'd
# get if a user's laptop went to sleep — the server tolerates it fine.
set -eu

log() { printf '[omnigent-runner-loop] %s\n' "$*"; }

log "omnigent CLI: $(omnigent --version 2>/dev/null || echo unknown)"
log "pi CLI:       $(pi --version 2>/dev/null || echo unknown)"
log "server URL:   ${OMNIGENT_SERVER_URL:-<unset>}"
log "account:      ${OMNIGENT_RUNNER_USERNAME:-${OMNIGENT_ADMIN_USERNAME:-<unset>}}"
log "PI wrapper:   ${OMNIGENT_PI_PATH:-<unset>}"

# --- 1. Wait for server -------------------------------------------------
if [ -n "${OMNIGENT_SERVER_URL:-}" ]; then
    # NB: use /health (returns {"status":"ok"} JSON), NOT /healthz.
    # /healthz is shadowed by the React SPA catch-all and returns HTML 200
    # even when the API is dead — a probe against it will "pass" forever.
    log "waiting for omnigent-server /health"
    i=0
    until curl -sSf --max-time 3 "${OMNIGENT_SERVER_URL}/health" >/dev/null 2>&1; do
        i=$((i + 1))
        if [ "$i" -ge 60 ]; then
            log "omnigent-server /health not answering after 5 min — bailing to sleep-forever"
            exec sleep infinity
        fi
        sleep 5
    done
    log "server up after $((i * 5))s"
fi

# --- 2. Log in ----------------------------------------------------------
if [ -z "${OMNIGENT_RUNNER_USERNAME:-${OMNIGENT_ADMIN_USERNAME:-}}" ] \
   || [ -z "${OMNIGENT_RUNNER_PASSWORD:-${OMNIGENT_ADMIN_PASSWORD:-}}" ]; then
    log "OMNIGENT_RUNNER_{USERNAME,PASSWORD} (or OMNIGENT_ADMIN_{USERNAME,PASSWORD}) unset — cannot auto-register"
    log "podman exec into the container and run omnigent login by hand"
    exec sleep infinity
fi
umask 077
tries=0
until omnigent-runner-login; do
    tries=$((tries + 1))
    if [ "${tries}" -ge 30 ]; then
        log "login still failing after ${tries} tries; exiting so systemd restarts the runner"
        log "check that the account's password secret matches the account (scripts/rotate-secrets.sh)"
        exit 1
    fi
    log "login failed; the account may not exist yet, retrying in 10s (${tries}/30)"
    sleep 10
done

# --- 3. Register as host in the background -----------------------------
start_host() {
    if ! omnigent host --background --non-interactive --server "${OMNIGENT_SERVER_URL}" 2>&1 | sed 's/^/[omnigent host] /'; then
        log "omnigent host --background returned non-zero (may already be running)"
    fi
}
# `host status` keeps listing a daemon whose process died, as "process": "offline",
# so "is anything listed" is not enough: look for a daemon whose process is online.
host_up() {
    omnigent host status --json --server "${OMNIGENT_SERVER_URL}" 2>/dev/null \
        | jq -e '[.daemons[]? | select(.process == "online")] | length > 0' >/dev/null 2>&1
}
log "registering as omnigent host"
start_host

# --- 4. Foreground: tail the host daemon log and watch over the runner ---
LOG_DIR="${HOME}/.omnigent/logs/host"
# The names are omnigent's own, host-<date>-<time>-<n>.log, so ls is safe here.
# shellcheck disable=SC2012
latest_log() { ls -t "${LOG_DIR}"/host-*.log 2>/dev/null | head -1; }
log "waiting for host daemon log directory to appear"
i=0
until [ -n "$(latest_log)" ]; do
    i=$((i + 1))
    [ "$i" -ge 30 ] && { log "no host log after 30s — falling back to sleep forever"; exec sleep infinity; }
    sleep 1
done
TAIL_PID=
follow_log() { # follow the newest daemon log; a restarted daemon writes a new file
    [ -z "${TAIL_PID}" ] || kill "${TAIL_PID}" 2>/dev/null || true
    LATEST=$(latest_log)
    log "tailing ${LATEST} in the foreground so podman/systemd sees a live process"
    tail -F "${LATEST}" &
    TAIL_PID=$!
}
trap 'kill "${TAIL_PID}" 2>/dev/null; exit 0' TERM INT
follow_log

INTERVAL="${OMNIGENT_RUNNER_CHECK_INTERVAL:-60}"
while kill -0 "${TAIL_PID}" 2>/dev/null; do
    sleep "${INTERVAL}" &
    wait $! || true
    omnigent-runner-login --ensure || log "could not keep the login fresh (see above); trying again in ${INTERVAL}s"
    if ! host_up; then
        log "host daemon is gone; starting it again"
        start_host
        sleep 3
        [ "$(latest_log)" = "${LATEST}" ] || follow_log
    fi
done
log "the log tail ended; exiting so systemd restarts the runner"
exit 1
