# Per-host settings for omnigent. scripts/install.sh copies this file to
# ~/.config/omnigent/omnigent.env (mode 0600) on the first install and renders the values
# into the Quadlet units. Edit that copy, then re-run install.sh: a changed value restarts
# the affected containers, an unchanged re-run restarts nothing.
#
# Plain KEY=VALUE lines: no quotes, no `export`, no trailing comments, no spaces.
# No passwords here: install.sh generates them as podman secrets (README "Secrets").

# Publish address and port of the web UI. Loopback only by default; put a tailnet or tunnel
# front end on this host in front of it. A LAN IP works too; 0.0.0.0 is refused.
OMNIGENT_BIND=127.0.0.1
OMNIGENT_PORT=8000

# Public or tailnet URL used in invite links and OAuth redirects. Empty lets upstream
# derive it from HOST/PORT, which is fine for loopback-only use. Example:
# OMNIGENT_ACCOUNTS_BASE_URL=https://<node>.<tailnet>.ts.net:9444
OMNIGENT_ACCOUNTS_BASE_URL=

# Admin account the runner logs in with, and that install.sh claims on first boot. Its
# password is the podman secret omnigent-admin-password.
OMNIGENT_ADMIN_USERNAME=admin

# pi state of the runner:
#   private  its own volume omnigent-pi-data (default; needs one `pi login` in the runner)
#   shared   pi-agent-data, the volume of Woow_podman_pi_agent_package (pi-web), which must
#            be installed first; the runner then sees pi-web's logins and skills
OMNIGENT_PI_STATE=private
