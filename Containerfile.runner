# Woow Omnigent runner — always-on sidecar that dials into omnigent-server
# and offers the `pi` harness to any session started from the web UI.
#
# What lives in here:
#   - Python 3.12 + pip install omnigent (upstream v0.11.0)
#   - Node 22 + @earendil-works/pi-coding-agent (pi CLI, same 0.83.0 pin
#     the code-server / OD / pi-web deployments use — the pi-agent-data
#     volume schema must agree across all four consumers)
#   - /usr/local/bin/pi-code — the HOME-rescoping wrapper (byte-identical
#     to the one code-server ships; kept in rootfs/ here for review, not
#     symlinked out of another repo, so this image is self-contained)
#   - /usr/local/bin/omnigent-runner-loop — discovers the right upstream
#     subcommand for a long-lived runner and stays in the foreground so
#     systemd sees a real process to supervise

# python:3.12-slim gives us Python 3.12 out of the box — omnigent requires
# >=3.12 and Debian 12 bookworm-slim ships 3.11 (found the hard way in
# the first build attempt). The image is still Debian-based so
# apt-get / nodesource / npm all behave the same as bookworm-slim.
FROM docker.io/library/python:3.12-slim

# ARGs declared BEFORE FROM only apply to that FROM line. Re-declare here
# so the RUN steps below actually see the pinned versions instead of an
# empty string that silently degrades to `pip install omnigent==` (any)
# and `npm install @earendil-works/pi-coding-agent@` (latest).
ARG OMNIGENT_VERSION=0.12.0
ARG PI_CODING_AGENT_VERSION=0.83.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Asia/Taipei \
    PI_TELEMETRY=0 \
    PI_SKIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    HOME=/omnigent-home

# --- Writable HOME for omnigent ------------------------------------------
# omnigent CLI wants $HOME/.omnigent/{logs,config,...} — its first act on
# any invocation is `log_dir.mkdir(parents=True)` which fails hard with
# PermissionError if HOME=/ (the default when neither the image nor the
# quadlet sets it explicitly). python:3.12-slim doesn't ship /root as
# writable to the process's effective uid under rootless podman's
# UserNS=keep-id mapping either, so we create a dedicated dir and set
# HOME to it — cheap and always writable regardless of userns.
#
# pi-code's own HOME rescoping is per-invocation (it exports HOME=
# /data/pi-agent/home just before exec'ing pi); this container-level
# HOME only governs omnigent's own state, not any pi subprocess it spawns.
RUN mkdir -p /omnigent-home && chmod 777 /omnigent-home

# --- System packages -----------------------------------------------------
# Node 22 (pi needs >=22), git + openssh-client for the harness to clone
# and push, curl+jq for the runner-loop discovery, tini for a proper PID
# 1 that reaps zombies. Python 3.12 comes from the base image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg jq openssh-client \
      tini tmux tzdata \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# --- pi CLI --------------------------------------------------------------
# Same version the sibling deployments pin (pi-web 0.13.2, code-server
# package v1, OD Dockerfile.full). Bump this and the sibling packages
# together — the pi-agent-data on-disk schema is not versioned.
# `pi --version` may emit an "outdated" advisory line as an extra stdout
# line even with PI_SKIP_VERSION_CHECK=1. Match the version substring
# anywhere in the first line instead of the whole output — a build-time
# smoke test to catch "wrong tarball" without failing on cosmetic noise.
RUN npm install -g --omit=dev --no-fund --no-audit \
      "@earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}" \
 && pi --version 2>&1 | head -1 | grep -qF "${PI_CODING_AGENT_VERSION}"

# --- omnigent runtime ----------------------------------------------------
# python:3.12-slim's python is not PEP 668-managed the way Debian's is,
# so a plain global install works and the `omnigent` entry point lands
# on PATH for the tini-launched command below. omnigent's C extension
# deps (psycopg 3, etc) all ship prebuilt cp312 manylinux wheels — no
# compiler needed in the image.
RUN pip3 install --no-cache-dir \
      "omnigent==${OMNIGENT_VERSION}" \
 && omnigent --version \
 && rm -rf /omnigent-home/.omnigent
# The `omnigent --version` above initialises $HOME/.omnigent/logs/cli
# as a side effect (its cli_diagnostics.setup_cli_logging fires
# unconditionally). At build time that runs as container root (uid 0),
# so the directory ends up owned uid=0 with mode 0755. At runtime with
# rootless podman + UserNS=keep-id, the container "root" is the host's
# uid 1000 — a different uid than the image's baked-in uid 0 — and
# therefore cannot write inside the 0755 .omnigent tree. Wipe it so
# the runtime user creates a fresh, correctly-owned copy on first use.

# --- Rootfs overlay ------------------------------------------------------
#   /usr/local/bin/pi-code               — HOME rescoping wrapper
#   /usr/local/bin/omnigent-runner-loop  — long-lived runner entrypoint
COPY rootfs/ /
RUN chmod +x /usr/local/bin/pi-code /usr/local/bin/omnigent-runner-loop \
 # Alias /usr/bin/pi to the wrapper. omnigent's native pi integration
 # hardcodes `/usr/bin/pi` in its tmux spawn command line and ignores
 # OMNIGENT_PI_PATH — verified live on the runner, PID 92's argv shows
 # `new-session -d ... /usr/bin/pi --extension ... --session-dir ...`.
 # Replacing /usr/bin/pi with our wrapper is the only way to get
 # omnigent's pi subprocess to inherit HOME=/data/pi-agent/home and
 # therefore share pi's auth/models with pi-web / OD / code-server.
 # Omnigent still pins its OWN session-dir via --session-dir so
 # conversation history stays omnigent-tracked — that separation is
 # by design and unaffected by the HOME rescoping.
 && rm -f /usr/bin/pi \
 && ln -s /usr/local/bin/pi-code /usr/bin/pi \
 && ls -l /usr/bin/pi

# The upstream image runs as root; we mirror that here because the
# omnigent CLI writes to $HOME/.omnigent/ and rootless podman with
# UserNS=keep-id maps container root back to the invoking host user.
# ENTRYPOINT tini so signals + child reaping are sane.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/omnigent-runner-loop"]

ARG BUILD_VERSION=dev
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="Woow Podman Omnigent Runner" \
      org.opencontainers.image.description="Omnigent always-on runner sidecar with pi CLI + pi-code wrapper wired to shared pi-agent-data" \
      org.opencontainers.image.source="https://github.com/WOOWTECH/Woow_podman_omnigent_package" \
      org.opencontainers.image.vendor="WOOWTECH" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"
