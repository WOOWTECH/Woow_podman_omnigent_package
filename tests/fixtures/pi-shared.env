# tests/dryrun.sh variant: shared pi state on a tailnet front end, as on woowtechopenclaw.
# The runner then references pi-agent-data.volume (tests/fixtures/refs/).
OMNIGENT_BIND=127.0.0.1
OMNIGENT_PORT=8000
OMNIGENT_ACCOUNTS_BASE_URL=https://omnigent-host.example-tailnet.ts.net:9444
OMNIGENT_ADMIN_USERNAME=woow
OMNIGENT_PI_STATE=shared
