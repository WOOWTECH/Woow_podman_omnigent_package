[Unit]
Description=Refresh omnigent container health state
Documentation=https://github.com/WOOWTECH/Woow_podman_omnigent_package
After=omnigent-server.service

[Service]
Type=oneshot
# Covers both containers that define a HealthCmd. On woowtechopenclaw podman's own transient
# health timers never recorded a result for omnigent-postgres (health=starting, empty log,
# 12 days), so this timer is the backstop. Bare `podman`: systemd resolves it on its fixed
# search path, so nothing is hardcoded.
ExecCondition=podman container exists omnigent-server
ExecStart=podman healthcheck run omnigent-server
ExecStart=-podman healthcheck run omnigent-postgres
